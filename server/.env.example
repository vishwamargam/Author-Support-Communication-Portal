NODE_ENV=development
PORT=4000
MONGODB_URI=replace-with-mongodb-connection-string
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_TTL_SECONDS=28800
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
COOKIE_SAME_SITE=lax
COOKIE_NAME=bookleaf_session
CSRF_COOKIE_NAME=bookleaf_csrf
ADMIN_COOKIE_NAME=bookleaf_admin_session
ADMIN_CSRF_COOKIE_NAME=bookleaf_admin_csrf

# Local demo credentials. The seed script refuses to run without these values.
# All 10 author accounts use DEMO_AUTHOR_PASSWORD; admin uses ADMIN_PASSWORD.
DEMO_AUTHOR_PASSWORD=choose-a-local-demo-password
ADMIN_EMAIL=replace-with-admin-email
ADMIN_PASSWORD=replace-with-a-separate-admin-password
SAMPLE_DATA_FILE=

# Optional Gemini support assistant. Keep the key only in server/.env.
# AI_PROVIDER=disabled preserves manual ticket creation and replies without live AI calls.
AI_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=12000
AI_CLASSIFICATION_MAX_TOKENS=250
AI_DRAFT_MAX_TOKENS=450
